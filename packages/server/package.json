{
  "name": "@idlekin/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env IDLEKIN_ALLOW_DEV_AUTH=1 tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "content:validate": "tsx src/content/validate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/websocket": "^11.2.0",
    "@idlekin/shared": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5"
  }
}
